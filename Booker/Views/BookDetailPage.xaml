<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Booker.ViewModels"
             x:Class="Booker.Views.BookDetailPage"
             Title="{Binding Book.Title}"
             BackgroundColor="#F5F0E8">

    <VerticalStackLayout Spacing="20" Padding="20" HorizontalOptions="Center" VerticalOptions="Center">
        
        <Label Text="{Binding Book.Title}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="{Binding Book.Author}" FontSize="16" TextColor="#8A7F6E" HorizontalOptions="Center" />
        
        <Label Text="{Binding Elapsed, StringFormat='{0:hh\\:mm\\:ss}'}" 
               FontSize="48" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               Margin="0,30" />
        
        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
            
            <Button Text="Start" 
                    Command="{Binding StartTimerCommand}" 
                    BackgroundColor="#4A9E6A" 
                    IsVisible="{Binding IsRunning, Converter={x:StaticResource InvertedBool}}" 
                    WidthRequest="120"/>
            
            <Button Text="Stop" 
                    Command="{Binding StopTimerCommand}" 
                    BackgroundColor="#C4572A" 
                    IsVisible="{Binding IsRunning}" 
                    WidthRequest="120"/>
            
        </HorizontalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>