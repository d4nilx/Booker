<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Booker.ViewModels"
             xmlns:models="clr-namespace:Booker.Models"
             x:Class="Booker.Views.LibraryPage"
             x:Name="PageRoot"
             Title="Library"
             BackgroundColor="#1C2B1E" Shell.NavBarIsVisible="False">

    <!-- BindingContext set via code-behind constructor -->

    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}"
                 RefreshColor="#8FBC8F">
        <CollectionView ItemsSource="{Binding MyLibrary}" Margin="16">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <Label Text="📚" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Your library is empty"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#F0EDE4"
                           HorizontalOptions="Center" />
                    <Label Text="Search for books and add them here"
                           FontSize="13"
                           TextColor="#7A9E7E"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SavedBook">
                    <SwipeView Margin="0,6">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="#C4572A"
                                           CommandParameter="{Binding .}"
                                           Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteBookCommand}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border BackgroundColor="#243327"
                                Stroke="#2E4030"
                                StrokeThickness="1">
                            
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenBookDetailsCommand}" />
                            </Border.GestureRecognizers>

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                        <Grid ColumnDefinitions="70,*"
                              ColumnSpacing="12"
                              Padding="12">

                            <Image Grid.Column="0"
                                   Source="{Binding Thumbnail}"
                                   HeightRequest="95"
                                   WidthRequest="70"
                                   Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="6" Rect="0,0,70,95"/>
                                </Image.Clip>
                            </Image>

                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#F0EDE4"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Author}"
                                       FontSize="12"
                                       TextColor="#7A9E7E" />

                                
                                <ProgressBar x:Name="ReadingProgress"
                                             ProgressColor="#8FBC8F"
                                             BackgroundColor="#2E4030"
                                             HeightRequest="3"
                                             Progress="{Binding ReadingProgress}" />

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           TextColor="#7A9E7E"
                                           FontSize="11">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PagesRead}" />
                                                <Span Text="/" />
                                                <Span Text="{Binding PageCount}" />
                                                <Span Text=" pages" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    
                                </Grid>

                                <Label Text="✓ Finished"
                                       FontSize="11"
                                       TextColor="#8FBC8F"
                                       IsVisible="{Binding IsFinished}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
